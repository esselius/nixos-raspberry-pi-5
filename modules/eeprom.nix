{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.pi5.eeprom;

  # `hardware.raspberry-pi.firmware.path` comes from nixos-hardware. The
  # fallback keeps this module importable on its own (for example when only the
  # options are evaluated).
  firmwarePath = lib.attrByPath [
    "hardware"
    "raspberry-pi"
    "firmware"
    "path"
  ] "/boot/firmware" config;

  renderValue = value: if lib.isBool value then (if value then "1" else "0") else toString value;

  # attrNames is sorted, so the rendered file - and the unit's ExecStart, which
  # embeds its store path - change only when a setting changes.
  # switch-to-configuration then restarts the oneshot and the script re-applies.
  configFile = pkgs.writeText "pi5-eeprom.conf" (
    lib.concatStringsSep "\n" (
      [
        "# Generated by pi5.eeprom. Do not edit; change the module options."
        "[all]"
      ]
      ++ lib.mapAttrsToList (name: value: "${name}=${renderValue value}") cfg.settings
    )
    + "\n"
  );
in
{
  options.pi5.eeprom = {
    enable = lib.mkEnableOption ''
      applying the declared bootloader EEPROM configuration at boot and when it
      changes
    '';

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.raspberrypi-eeprom;
      defaultText = lib.literalExpression "pkgs.raspberrypi-eeprom";
      description = ''
        Package providing `rpi-eeprom-config` and the bootloader images.

        `rpi-eeprom-config --apply` merges the settings into this package's
        newest bootloader image, so the package also selects the bootloader
        version that gets flashed.
      '';
    };

    settings = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.oneOf [
          lib.types.bool
          lib.types.int
          lib.types.str
        ]
      );
      default = { };
      example = {
        BOOT_ORDER = "0xf416";
        PCIE_PROBE = 1;
      };
      description = ''
        Bootloader EEPROM `KEY=value` settings, written under `[all]`. Booleans
        render as `1`/`0` and integers as decimal; strings are written verbatim.
        Quote hexadecimal values (`BOOT_ORDER = "0xf416"`): a Nix integer would
        be rendered as decimal and mean something else.

        The settings are overrides on top of the running configuration. A key
        removed here is left alone on the board: the EEPROM is board state, not
        a NixOS generation, and it is not rolled back. To revert a key, set the
        bootloader's documented default value explicitly.
      '';
    };

    configFile = lib.mkOption {
      type = lib.types.path;
      readOnly = true;
      internal = true;
      default = configFile;
      description = "Rendered EEPROM configuration, as passed to `rpi-eeprom-config`.";
    };
  };

  config = lib.mkMerge [
    {
      assertions = [
        {
          assertion = !cfg.enable || cfg.settings != { };
          message = ''
            pi5.eeprom.enable is true but pi5.eeprom.settings is empty. The
            service would run with nothing to apply. Set the keys you want (for
            example BOOT_ORDER = "0xf416") or leave the module disabled.
          '';
        }
        {
          assertion = lib.all (name: builtins.match "[A-Z0-9_]+" name != null) (lib.attrNames cfg.settings);
          message = ''
            pi5.eeprom.settings keys must be bootloader configuration names:
            uppercase letters, digits, and underscores (for example BOOT_ORDER
            or PCIE_PROBE).
          '';
        }
        {
          assertion = lib.all (
            value: !(lib.isString value) || (!(lib.hasInfix "\n" value) && !(lib.hasInfix "\r" value))
          ) (lib.attrValues cfg.settings);
          message = ''
            pi5.eeprom.settings values must not contain newlines: the config is
            rendered as one KEY=value per line.
          '';
        }
      ];
    }

    (lib.mkIf cfg.enable {
      # `rpi-eeprom-config` with no arguments prints the running configuration,
      # which is the manual way to inspect what the service applied.
      environment.systemPackages = [ cfg.package ];

      systemd.services.pi5-eeprom = {
        description = "Apply the declared Raspberry Pi 5 bootloader EEPROM configuration";
        wantedBy = [ "multi-user.target" ];
        after = [ "local-fs.target" ];
        # The bootloader reads recovery.bin from the firmware partition while
        # the SPI write is in progress, so that partition has to be mounted.
        unitConfig.RequiresMountsFor = firmwarePath;
        path = [
          cfg.package
          pkgs.coreutils
          pkgs.gnugrep
          pkgs.gnused
          # findmnt and blkid: rpi-eeprom-update probes for the boot filesystem
          # before it writes the rollback recovery.bin.
          pkgs.util-linux
        ];
        serviceConfig = {
          Type = "oneshot";
          # Without RemainAfterExit systemd considers a oneshot inactive after
          # it exits and switch-to-configuration may start it again.
          RemainAfterExit = true;
          # flashrom writes the SPI EEPROM and retries at lower speeds; the
          # default 90s is too short when a probe or verify has to retry.
          TimeoutStartSec = "300";
          ExecStart = "${pkgs.runtimeShell} ${./eeprom-apply.sh} ${configFile}";
        };
      };
    })
  ];
}
